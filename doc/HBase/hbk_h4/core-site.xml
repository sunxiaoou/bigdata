<configuration>
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://hadoop4:8020</value>
    </property>
    <property>
        <name>hadoop.tmp.dir</name>
        <value>/usr/local/hadoop-3.3.6/data/tmp</value>
    </property>
    <property>
        <name>hadoop.security.authentication</name>
        <value>kerberos</value>
    </property>
    <property>
        <name>hadoop.security.authorization</name>
        <value>true</value>
    </property>
    <property>
        <name>hadoop.http.authentication.kerberos.principal</name>
        <value>HTTP/hadoop4@XO.COM</value>
    </property>
    <property>
        <name>hadoop.http.authentication.kerberos.keytab</name>
        <value>/opt/krb5/keytabs/hadoop.keytab</value>
    </property>
    <property>
        <name>hadoop.security.auth_to_local</name>
        <value>
            RULE:[2:$1/$2@$0](hdfs\/.*@XO\.COM)s/.*/hdfs/
            RULE:[2:$1/$2@$0](yarn\/.*@XO\.COM)s/.*/hdfs/
            RULE:[2:$1/$2@$0](mapred\/.*@XO\.COM)s/.*/hdfs/
            RULE:[2:$1/$2@$0](hbase\/.*@XO\.COM)s/.*/hdfs/
            DEFAULT
        </value>
    </property>
</configuration>
